# ===== easySVA 部署环境变量（按需修改，一般保持默认即可）=====
# 前端访问端口（浏览器打开 http://localhost:WEB_PORT）
# 固定用 80：告警抓拍/录像的 URL 由后端按 80 端口拼接，改成其它端口会导致“暂无抓拍”
WEB_PORT=80
# 媒体 HTTP/WS-FLV 端口（ZLMediaKit，独立于前端端口）
WEB_HTTP_PORT=9992

# 数据库
MYSQL_DB=easySVA
MYSQL_PASSWORD=easySVA.EZ

# ZLMediaKit 密钥（需与库内 zlm_server.secret 保持一致，默认已对齐）
ZLM_SECRET=V3522025zlm0aA9ajn7UiOWi

# GB28181 国标参数
PLATFORM_ID=34020000002000000001
REALM=3402000000
DEVICE_PASSWORD=12345678
GB_DEVICE_ID=34020000001320000001
GB_CHANNEL_ID=34020000001320000002
TARGET_STREAM=gb_34020000001320000002_0100000016
